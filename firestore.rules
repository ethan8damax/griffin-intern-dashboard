rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dashboard/{docId} {
      allow read, write: if true;
    }

    // All reads/writes to the collections below normally happen server-side via
    // the Firebase Admin SDK, which bypasses these rules entirely. The rules here
    // are a defense-in-depth backstop against a client ever calling Firestore
    // directly with a signed-in user's credentials.

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveCompanyAdmin() {
      return request.auth != null &&
        callerDoc().role == "companyAdmin" &&
        callerDoc().status != "removed";
    }

    function isActiveEngagementLead() {
      return request.auth != null &&
        callerDoc().role == "engagementLead" &&
        callerDoc().status != "removed";
    }

    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isActiveCompanyAdmin());
      allow write: if false;

      match /timeline/{milestoneId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if isActiveCompanyAdmin() || isActiveEngagementLead();
      }

      match /goals/{goalId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if isActiveCompanyAdmin() || isActiveEngagementLead() ||
          (request.auth != null && request.auth.uid == uid);
      }

      match /journal/{entryId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /priorities/{priorityId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if isActiveCompanyAdmin() || isActiveEngagementLead() ||
          (request.auth != null && request.auth.uid == uid);
      }

      match /projects/{projectId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if isActiveCompanyAdmin() || isActiveEngagementLead() ||
          (request.auth != null && request.auth.uid == uid);
      }

      match /profile/{docId} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isActiveCompanyAdmin() || isActiveEngagementLead());
        allow write: if isActiveCompanyAdmin() || isActiveEngagementLead() ||
          (request.auth != null && request.auth.uid == uid);
      }
    }

    match /engagements/{engagementId} {
      allow read: if request.auth != null &&
        ((resource.data.leadUserId == request.auth.uid && callerDoc().status != "removed") ||
         isActiveCompanyAdmin());
      allow write: if isActiveCompanyAdmin();

      function isOwnEngagementLead() {
        return isActiveEngagementLead() && callerDoc().engagementId == engagementId;
      }

      function isOwnEngagementIntern() {
        return request.auth != null &&
          callerDoc().role == "intern" &&
          callerDoc().status != "removed" &&
          callerDoc().engagementId == engagementId;
      }

      match /goals/{goalId} {
        allow read: if request.auth != null &&
          (isActiveCompanyAdmin() || isOwnEngagementLead() || isOwnEngagementIntern());
        allow write: if isActiveCompanyAdmin() || isOwnEngagementLead();
      }

      match /priorities/{priorityId} {
        allow read: if request.auth != null &&
          (isActiveCompanyAdmin() || isOwnEngagementLead() || isOwnEngagementIntern());
        allow write: if isActiveCompanyAdmin() || isOwnEngagementLead();
      }

      // Note: resource.data.authorUid only exists on update/delete, not create —
      // this rule under-permits intern-authored creates via direct client access.
      // Harmless here since all real writes go through Server Actions (Admin SDK),
      // which bypass this file entirely.
      match /reflections/{reflectionId} {
        allow read: if request.auth != null &&
          (isActiveCompanyAdmin() || isOwnEngagementLead() || isOwnEngagementIntern());
        allow write: if isActiveCompanyAdmin() || isOwnEngagementLead() ||
          (isOwnEngagementIntern() && resource.data.authorUid == request.auth.uid);
      }

      match /reviews/{reviewId} {
        allow read: if request.auth != null &&
          (isActiveCompanyAdmin() || isOwnEngagementLead() ||
           request.auth.uid == resource.data.subjectUserId);
        allow write: if isActiveCompanyAdmin() || isOwnEngagementLead();
      }
    }

    match /invites/{inviteId} {
      allow read, write: if isActiveCompanyAdmin() || isActiveEngagementLead();
    }
  }
}
